# Leave empty in dev (uses the Vite proxy). In production set the full backend URL:
# VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=

# WhatsApp support phone in international digits only (e.g. 919876543210; no +, spaces, or dashes)
VITE_WHATSAPP_NUMBER=9137674022

# Optional Render Blueprint setting: backend hostname only, without https://
VITE_API_HOST=
